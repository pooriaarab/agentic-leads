{
  "name": "agentic-leads",
  "version": "0.2.1",
  "description": "Find leads with Google Places, Apify, Apollo, Treg, local CSV files, and National Weather Service alerts through a TypeScript SDK, CLI, and MCP.",
  "keywords": [
    "lead-generation",
    "prospecting",
    "google-places",
    "apify",
    "apollo",
    "treg",
    "hunter",
    "csv",
    "national-weather-service",
    "enrichment",
    "typescript",
    "cli",
    "mcp"
  ],
  "license": "MIT",
  "author": "Pooria Arab",
  "repository": {
    "type": "git",
    "url": "https://github.com/pooriaarab/agentic-leads.git"
  },
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "files": [
    "dist",
    "examples",
    "docs",
    "server.json",
    ".mcp.json",
    "AGENTS.md",
    "RULES.md",
    "SKILL.md",
    "llms.txt",
    "agentic-core.d.ts"
  ],
  "publishConfig": {
    "access": "public"
  },
  "mcpName": "io.github.pooriaarab/agentic-leads",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "agentic-leads": "./dist/cli.js",
    "agentic-leads-mcp": "./dist/mcp-bin.js"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "zod": "^3.25.0",
    "agentic-core": "^0.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  }
}
